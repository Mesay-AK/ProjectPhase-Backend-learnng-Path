type Task {
  id: ID!
  title: String!
  description: String!
  done: Boolean!
}

type Query {
  tasks: [Task!]!
  task(id: ID!): Task
}

# input createdTask {
#   id: ID!
#   title: String!
#   description: String!
#   done: Boolean!
# }
# input UpdatedTask {
#   title: String
#   description: String
#   done: Boolean
# }

type Mutation {
  createTask(title: String!, description: String!): Task!
  updateTask(id: ID!, title: String, description: String, done: Boolean): Task!
  deleteTask(id: ID!): Boolean!
}
