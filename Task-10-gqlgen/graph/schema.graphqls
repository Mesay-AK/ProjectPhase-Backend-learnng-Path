type Task {
  id: ID!
  title: String!
  description: String
  completed: Boolean!
  createdAt: String!
}

type Query {
  getTasks: [Task!]!
  getTask(id: ID!): Task
}

type Mutation {
  addTask(title: String!, description: String): Task!
  updateTask(
    id: ID!
    title: String
    description: String
    completed: Boolean
  ): Task!
  deleteTask(id: ID!): Boolean!
}
